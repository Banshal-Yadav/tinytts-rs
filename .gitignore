# Rust build artifacts
runtime/target/

# Model weights (8.4 MB, re-downloadable from Hugging Face; see MODEL.md)
*.onnx
!runtime/**/*.onnx

# Golden tensors for the differential test (~3.4 GB for three lengths).
# Regenerate with:
#   python scripts/verify/dump_golden.py paradee_int8.onnx golden
# before running `cargo test`.
golden/
golden_short/
golden_long/
*.npy

# Scratch / debug dumps
probe*.onnx
runtime/out.txt
runtime/out.wav
runtime/my_*.txt
runtime/bt.txt
runtime/node_diff.csv
out.wav
scripts/_*.py
scripts/_*.rs
scripts/_*.exe
scripts/_*.pdb
scripts/_*.json

# Python
.venv/
__pycache__/
*.pyc

# OS
Thumbs.db
.DS_Store

# Scratch outputs
samples/_*.wav
samples/*.mp3
scripts/*.exe
scripts/*.pdb
scripts/liveness.json

# Generated audio samples (timestamped). Not tracked.
audio_out/
samples/say.wav

# Interleaved A/B benchmark worktrees and their target dirs
.abwork/
docs/ab_last.json
docs/benchmark.json

# Instructions for AI coding agents. Not part of the published repository.
AGENTS.md

# Internal engineering docs (optimization log, benchmark tables, research
# notes, testing harness). Kept local, not published.
docs/

# tinytts-g2p embedded lexicon (12.8 MB, generated). Regenerate with:
#   python g2p/gen_lexicon.py g2p/src/lexicon.bin
g2p/src/lexicon.bin

# CMUdict source for the lexicon generator and the reference (3.4 MB,
# re-downloadable). Fetch:
# https://raw.githubusercontent.com/cmusphinx/cmudict/master/cmudict.dict
# (see g2p/THIRD_PARTY_NOTICES.md for the license and regeneration steps)
g2p/cmudict.dict
g2p/reference/cmudict.dict

# Text inputs and samples not part of the repo.
text/
g2p/dev/*.json
g2p/dev/*.txt

# Agent experiment notes (failed patches, failure records). Not part of the repo.
agent-notes/
